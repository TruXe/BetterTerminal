  <!-- Build-time packaging: the whole C# build is packed into payload.pack before the resource
       compiler embeds it. The application must be built first; the solution declares that order as
       a dependency on BetterTerminal.Shell. -->
  <Target Name="PackPayload" BeforeTargets="ResourceCompile">
    <Message Importance="high" Text="Packing C# payload for $(Configuration)..." />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)..\tools\pack-payload.ps1&quot; -SourceDir &quot;$(ProjectDir)..\BetterTerminal.Shell\bin\x64\$(Configuration)&quot; -OutFile &quot;$(ProjectDir)payload.pack&quot;" />
