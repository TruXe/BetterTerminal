#include <windows.h>
#include "resource.h"

// The application icon, so the launcher carries the same mark as the application it starts. The
// lowest icon id is the one Explorer shows for the executable.
IDI_APPICON ICON "../BetterTerminal.Shell/Assets/BetterTerminal.ico"

// The whole C# application build, packed by tools\pack-payload.ps1 before this file is compiled.
// It is embedded as raw data and never distributed on its own.
IDR_PAYLOAD RCDATA "payload.pack"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,4,4,0
 PRODUCTVERSION 1,4,4,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "BetterTerminal"
            VALUE "FileDescription", "BetterTerminal (BETA)"
            VALUE "FileVersion", "1.4.4.0"
            VALUE "InternalName", "BetterTerminal.exe"
            VALUE "OriginalFilename", "BetterTerminal.exe"
            VALUE "ProductName", "BetterTerminal"
            VALUE "ProductVersion", "1.4.4 BETA"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
