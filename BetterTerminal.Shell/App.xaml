<Application x:Class="BetterTerminal.Shell.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Merge order is the token tier order (DS-02). Slot 1 is the theme slot and slot 7
                 the terminal scheme slot; ThemeService is the only code that replaces either. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Primitives.xaml"/>
                <ResourceDictionary Source="Themes/Tokens.Dark.xaml"/>
                <ResourceDictionary Source="Themes/Typography.xaml"/>
                <ResourceDictionary Source="Themes/Motion.xaml"/>
                <ResourceDictionary Source="Themes/Brand.xaml"/>
                <ResourceDictionary Source="Themes/Converters.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
                <ResourceDictionary Source="Themes/Schemes/Campbell.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
