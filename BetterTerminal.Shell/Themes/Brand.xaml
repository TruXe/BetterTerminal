<!-- Brand mark: one geometry, scaled through a Viewbox so the stroke stays proportional
     at every size (no raster, so no blur at 150/200% - SLOP-55, SLOP-58). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StreamGeometry x:Key="Bt.Geometry.Mark">M9.2,10.8 L14.6,16 L9.2,21.2 M18.2,21.2 L24.2,21.2</StreamGeometry>

    <!-- <Control Style="{StaticResource Bt.BrandMark}" Width="17" Height="17"/>
         Foreground overrides the amber default (e.g. single-colour on a coloured surface). -->
    <Style x:Key="Bt.BrandMark" TargetType="Control">
        <Setter Property="Foreground" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Width" Value="20"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="32" Height="32">
                            <Path Data="{StaticResource Bt.Geometry.Mark}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="3"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Wordmark: mark + "Better" semibold + "Terminal" regular secondary. -->
    <Style x:Key="Bt.Wordmark" TargetType="Control">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Control Style="{StaticResource Bt.BrandMark}"
                                 Width="{TemplateBinding Height}" Height="{TemplateBinding Height}"/>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource Bt.Font.Display}"
                                   FontSize="{TemplateBinding FontSize}">
                            <Run Text="Better" FontWeight="SemiBold"
                                 Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"/><Run
                                 Text="Terminal" FontWeight="Normal"
                                 Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.Title}"/>
    </Style>
</ResourceDictionary>
