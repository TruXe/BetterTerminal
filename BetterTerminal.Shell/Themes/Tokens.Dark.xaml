<!-- Tier 2 (DS-02): semantic brushes. Dark - the shipped default.
     Every key here exists with the same name in every sibling Tokens.*.xaml (DS-04 parity). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Primitives.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <sys:String x:Key="Bt.Theme.Id">Dark</sys:String>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Bt.WindowBackgroundBrush" Color="{StaticResource Bt.Color.Neutral.950}"/>
    <SolidColorBrush x:Key="Bt.ChromeBackgroundBrush" Color="{StaticResource Bt.Color.Neutral.900}"/>
    <SolidColorBrush x:Key="Bt.SurfaceBackgroundBrush" Color="{StaticResource Bt.Color.Neutral.850}"/>
    <SolidColorBrush x:Key="Bt.ElevatedBackgroundBrush" Color="{StaticResource Bt.Color.Neutral.800}"/>
    <SolidColorBrush x:Key="Bt.TerminalBackgroundBrush" Color="{StaticResource Bt.Color.Neutral.1000}"/>
    <SolidColorBrush x:Key="Bt.ScrimBrush" Color="{StaticResource Bt.Color.Scrim}"/>

    <!-- Strokes -->
    <SolidColorBrush x:Key="Bt.StrokeSubtleBrush" Color="{StaticResource Bt.Color.Neutral.700}"/>
    <SolidColorBrush x:Key="Bt.StrokeDefaultBrush" Color="{StaticResource Bt.Color.Neutral.750}"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Bt.TextFillPrimaryBrush" Color="{StaticResource Bt.Color.Foam}"/>
    <SolidColorBrush x:Key="Bt.TextFillSecondaryBrush" Color="{StaticResource Bt.Color.Neutral.400}"/>
    <SolidColorBrush x:Key="Bt.TextFillTertiaryBrush" Color="{StaticResource Bt.Color.Neutral.500}"/>
    <SolidColorBrush x:Key="Bt.TextFillDisabledBrush" Color="{StaticResource Bt.Color.Neutral.500}"/>

    <!-- Accent -->
    <SolidColorBrush x:Key="Bt.AccentFillDefaultBrush" Color="{StaticResource Bt.Color.Accent}"/>
    <SolidColorBrush x:Key="Bt.AccentFillPointerOverBrush" Color="{StaticResource Bt.Color.AccentLight}"/>
    <SolidColorBrush x:Key="Bt.AccentFillPressedBrush" Color="{StaticResource Bt.Color.AccentDark}"/>
    <SolidColorBrush x:Key="Bt.AccentFillDisabledBrush" Color="{StaticResource Bt.Color.Neutral.700}"/>
    <SolidColorBrush x:Key="Bt.AccentTextBrush" Color="{StaticResource Bt.Color.AccentLight}"/>
    <SolidColorBrush x:Key="Bt.AccentInkBrush" Color="{StaticResource Bt.Color.AccentInk}"/>
    <SolidColorBrush x:Key="Bt.AccentWashBrush" Color="{StaticResource Bt.Color.Overlay.AccentWashDark}"/>

    <!-- Control fills (state layers) -->
    <SolidColorBrush x:Key="Bt.ControlFillDefaultBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Bt.ControlFillPointerOverBrush" Color="{StaticResource Bt.Color.Overlay.LightHover}"/>
    <SolidColorBrush x:Key="Bt.ControlFillPressedBrush" Color="{StaticResource Bt.Color.Overlay.LightPress}"/>
    <SolidColorBrush x:Key="Bt.ControlFillDisabledBrush" Color="Transparent"/>
    <SolidColorBrush x:Key="Bt.ControlFillInputBrush" Color="{StaticResource Bt.Color.Neutral.800}"/>

    <!-- Status -->
    <SolidColorBrush x:Key="Bt.StatusSuccessBrush" Color="{StaticResource Bt.Color.Success.Dark}"/>
    <SolidColorBrush x:Key="Bt.StatusWarningBrush" Color="{StaticResource Bt.Color.Warning.Dark}"/>
    <SolidColorBrush x:Key="Bt.StatusErrorBrush" Color="{StaticResource Bt.Color.Error.Dark}"/>
    <SolidColorBrush x:Key="Bt.CloseButtonPointerOverBrush" Color="{StaticResource Bt.Color.CloseRed}"/>
    <SolidColorBrush x:Key="Bt.CloseButtonForegroundPointerOverBrush" Color="{StaticResource Bt.Color.Neutral.0}"/>

    <!-- Focus -->
    <SolidColorBrush x:Key="Bt.FocusStrokeOuterBrush" Color="{StaticResource Bt.Color.Foam}"/>
    <SolidColorBrush x:Key="Bt.FocusStrokeInnerBrush" Color="{StaticResource Bt.Color.Neutral.950}"/>

    <!-- Code (DS-04 parity: the same eight keys in every sibling). -->
    <SolidColorBrush x:Key="Bt.Syntax.CommentBrush" Color="{StaticResource Bt.Color.Code.Comment.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.StringBrush" Color="{StaticResource Bt.Color.Code.String.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.NumberBrush" Color="{StaticResource Bt.Color.Code.Number.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.KeywordBrush" Color="{StaticResource Bt.Color.Code.Keyword.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.TagBrush" Color="{StaticResource Bt.Color.Code.Tag.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.AttributeBrush" Color="{StaticResource Bt.Color.Code.Attribute.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.PropertyBrush" Color="{StaticResource Bt.Color.Code.Property.Dark}"/>
    <SolidColorBrush x:Key="Bt.Syntax.OperatorBrush" Color="{StaticResource Bt.Color.Code.Operator.Dark}"/>
</ResourceDictionary>
