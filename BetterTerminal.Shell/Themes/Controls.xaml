<!-- Tier 3 (DS-02): component styles. Semantic tokens only, no literals (DS-10). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ===== Focus visual (DS-13, BP-R26): one style, theme-wide, never removed ===== -->
    <Style x:Key="Bt.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6"
                               Stroke="{DynamicResource Bt.FocusStrokeOuterBrush}"
                               StrokeThickness="2" SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Buttons ===== -->
    <Style x:Key="Bt.Button.Base" TargetType="ButtonBase">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.ControlHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Bt.Space.ButtonPad}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Cursor" Value="Arrow"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Fill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Bt.Radius.Control}">
                        <ContentPresenter x:Name="Content"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillDisabledBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary action. Amber fill, ink-on-amber text (8.7:1). -->
    <Style x:Key="Bt.Button.Accent" TargetType="Button" BasedOn="{StaticResource Bt.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.AccentInkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bt.AccentFillPointerOverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Bt.AccentFillPressedBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Bt.AccentFillDisabledBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Bt.Button.Secondary" TargetType="Button" BasedOn="{StaticResource Bt.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bt.ControlFillDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Command-bar / pane-header ghost button: icon + optional label. -->
    <Style x:Key="Bt.Button.Chrome" TargetType="Button" BasedOn="{StaticResource Bt.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Bt.ControlFillDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.ControlHeightCompact}"/>
        <Setter Property="Padding" Value="9,0,9,0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Bt.Button.Icon" TargetType="Button" BasedOn="{StaticResource Bt.Button.Chrome}">
        <Setter Property="Width" Value="{DynamicResource Bt.Size.ControlHeightCompact}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Caption buttons. Square, no radius, close turns red on hover (Windows convention). -->
    <Style x:Key="Bt.Button.Caption" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Icon}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="{DynamicResource Bt.Size.WindowButtonWidth}"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.WindowButtonHeight}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillSecondaryBrush}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab-strip actions that live in the caption strip: same band, height, fill and hover as a
         window button, on a square target - they are accessories, not window controls. -->
    <Style x:Key="Bt.Button.CaptionAccessory" TargetType="Button" BasedOn="{StaticResource Bt.Button.Caption}">
        <Setter Property="Width" Value="{DynamicResource Bt.Size.CaptionAccessoryWidth}"/>
    </Style>

    <!-- A caption accessory that carries a label and the accent fill: the one action in the strip
         that is worth finding rather than recognising. Same band and height as its neighbours, so
         the strip stays one row of controls. -->
    <Style x:Key="Bt.Button.CaptionAccent" TargetType="Button" BasedOn="{StaticResource Bt.Button.Caption}">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.AccentInkBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.AccentFillDefaultBrush}"
                            CornerRadius="{DynamicResource Bt.Radius.Control}"
                            Margin="0,4,8,4">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentFillPressedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.Button.CaptionClose" TargetType="Button" BasedOn="{StaticResource Bt.Button.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}">
                        <ContentPresenter x:Name="Glyph" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.CloseButtonPointerOverBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Bt.CloseButtonForegroundPointerOverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== TextBox ===== -->
    <Style x:Key="Bt.TextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.ControlHeight}"/>
        <Setter Property="Padding" Value="{DynamicResource Bt.Space.ControlPad}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Fill"
                            Background="{DynamicResource Bt.ControlFillInputBrush}"
                            BorderBrush="{DynamicResource Bt.StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Bt.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Bt.TextFillTertiaryBrush}"/>
                        </Trigger>
                        <!-- Focus reads as a 2 px accent border, not a removed outline (BP-R26). -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                            <Setter TargetName="Fill" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillDisabledBrush}"/>
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Bt.StrokeSubtleBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.TextBox.Mono" TargetType="TextBox" BasedOn="{StaticResource Bt.TextBox}">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.Mono}"/>
    </Style>

    <!-- A whole file, not a field: it keeps the stock template, which is the one that scrolls. -->
    <Style x:Key="Bt.TextBox.Editor" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.Mono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Bt.TerminalBackgroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8,10,8"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="AcceptsTab" Value="True"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="SpellCheck.IsEnabled" Value="False"/>
    </Style>

    <!-- ===== ComboBox ===== -->
    <Style x:Key="Bt.ComboBox.ToggleButton" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Fill"
                            Background="{DynamicResource Bt.ControlFillInputBrush}"
                            BorderBrush="{DynamicResource Bt.StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Bt.Radius.Control}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}"
                            CornerRadius="{DynamicResource Bt.Radius.Control}" Margin="4,1,4,1">
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentWashBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.ComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.ControlHeightCompact}"/>
        <Setter Property="MinWidth" Value="172"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource Bt.ComboBoxItem}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="PART_ToggleButton"
                                      Style="{StaticResource Bt.ComboBox.ToggleButton}"
                                      Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
                        <Grid Margin="10,0,8,0" IsHitTestVisible="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <TextBlock Grid.Column="1" Style="{StaticResource Bt.Text.Icon}" Text="&#xE70D;"
                                       FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"/>
                        </Grid>
                        <Popup x:Name="PART_Popup" AllowsTransparency="True" Placement="Bottom"
                               VerticalOffset="4" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                            <Border Background="{DynamicResource Bt.ElevatedBackgroundBrush}"
                                    BorderBrush="{DynamicResource Bt.StrokeDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Bt.Radius.Card}"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Padding="0,4,0,4">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Toggle switch ===== -->
    <Style x:Key="Bt.ToggleSwitch" TargetType="ToggleButton">
        <Setter Property="Width" Value="38"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Track" CornerRadius="10"
                            Background="{DynamicResource Bt.StrokeDefaultBrush}">
                        <Border x:Name="Knob" Width="16" Height="16" CornerRadius="8"
                                HorizontalAlignment="Left" Margin="2,0,0,0"
                                Background="{DynamicResource Bt.TextFillSecondaryBrush}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="KnobShift" X="0"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Knob travels on RenderTransform, never Margin (MO-02). -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Bt.AccentInkBrush}"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="18" Duration="{StaticResource Motion.Duration.Faster}"
                                                         EasingFunction="{StaticResource Motion.Ease.Standard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobShift" Storyboard.TargetProperty="X"
                                                         To="0" Duration="{StaticResource Motion.Duration.Faster}"
                                                         EasingFunction="{StaticResource Motion.Ease.Standard}"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Bt.StrokeSubtleBrush}"/>
                            <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Bt.TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented control (RadioButton group) ===== -->
    <Style x:Key="Bt.Segment" TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillSecondaryBrush}"/>
        <Setter Property="Padding" Value="11,7,11,7"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillInputBrush}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Bt.AccentInkBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillDisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Radio used as a theme preview card (Appearance page). -->
    <Style x:Key="Bt.ThemeCard" TargetType="RadioButton">
        <Setter Property="Width" Value="186"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Card"
                            Background="{DynamicResource Bt.ElevatedBackgroundBrush}"
                            BorderBrush="{DynamicResource Bt.StrokeDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource Bt.Radius.Card}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Bt.TextFillTertiaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Settings navigation list ===== -->
    <Style x:Key="Bt.NavItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="11,0,11,0"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}"
                                CornerRadius="{DynamicResource Bt.Radius.Control}"/>
                        <!-- Selection rail: 2 px accent bar + wash, never colour alone (BP-R27). -->
                        <Border x:Name="Rail" Width="2" HorizontalAlignment="Left" Margin="0,7,0,7"
                                CornerRadius="1" Background="Transparent"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentWashBrush}"/>
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.ListBox.Plain" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <!-- Profiles and scroll-back lists exceed 200 items; virtualization stays on (BP-R9). -->
        <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
    </Style>

    <!-- Generic row for master lists (profiles, schemes, keybindings). -->
    <Style x:Key="Bt.RowItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="40"/>
        <Setter Property="Padding" Value="10,0,10,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}"
                                CornerRadius="{DynamicResource Bt.Radius.Control}"/>
                        <Border x:Name="Rail" Width="2" HorizontalAlignment="Left" Margin="0,8,0,8"
                                CornerRadius="1" Background="Transparent"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentWashBrush}"/>
                            <Setter TargetName="Rail" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tabs in the title bar ===== -->
    <Style x:Key="Bt.TabItem" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Ui}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.BodySmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillSecondaryBrush}"/>
        <Setter Property="Height" Value="31"/>
        <Setter Property="MaxWidth" Value="250"/>
        <Setter Property="MinWidth" Value="96"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Fill" Background="{DynamicResource Bt.ControlFillDefaultBrush}"
                            CornerRadius="{DynamicResource Bt.Radius.TabTop}"
                            Padding="11,0,10,0" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Indicator" Height="2" VerticalAlignment="Top"
                                    Margin="-11,0,-10,0" Background="Transparent"/>
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.SurfaceBackgroundBrush}"/>
                            <Setter TargetName="Indicator" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Height" Value="{DynamicResource Bt.Size.TabHeight}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Applied to the code view, which derives from this type. -->
    <Style x:Key="Bt.CodeEditor" TargetType="RichTextBox">
        <Setter Property="FontFamily" Value="{DynamicResource Bt.Font.Mono}"/>
        <Setter Property="FontSize" Value="{DynamicResource Bt.FontSize.Mono}"/>
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="Background" Value="{DynamicResource Bt.TerminalBackgroundBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeSubtleBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,8,10,8"/>
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <!-- ===== Folder tree ===== -->
    <Style x:Key="Bt.TreeView.Expander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE76C;"
                                   FontFamily="{DynamicResource Bt.Font.Icon}" FontSize="9"
                                   Foreground="{DynamicResource Bt.TextFillTertiaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="Text" Value="&#xE70D;"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.TreeViewItem" TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillPrimaryBrush}"/>
        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource Bt.FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border x:Name="Fill" Grid.Row="0" Height="26" Padding="2,0,8,0"
                                Background="Transparent"
                                CornerRadius="{DynamicResource Bt.Radius.Control}">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton x:Name="Expander"
                                              Style="{StaticResource Bt.TreeView.Expander}"
                                              ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <ContentPresenter ContentSource="Header" Margin="4,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <!-- The children carry the indentation; the row above never moves. -->
                        <ItemsPresenter x:Name="Items" Grid.Row="1" Margin="16,0,0,0"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Items" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <!-- On the row, not on the item: an item is "under the mouse" while any
                             of its children is, which would light up every folder above it. -->
                        <Trigger SourceName="Fill" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.ControlFillPointerOverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.AccentWashBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Badge (shell version, exit code, profile source) ===== -->
    <Style x:Key="Bt.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Bt.Radius.Badge}"/>
        <Setter Property="Padding" Value="6,4,6,4"/>
        <Setter Property="Background" Value="{DynamicResource Bt.AccentWashBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Bt.Badge.Outline" TargetType="Border" BasedOn="{StaticResource Bt.Badge}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="5,3,5,3"/>
    </Style>

    <!-- ===== Card / pane shells ===== -->
    <Style x:Key="Bt.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Bt.SurfaceBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Bt.Radius.Card}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- ===== GridSplitter ===== -->
    <!-- Direction and behaviour are stated, never inferred. Left to BasedOnAlignment the control
         uses its own default HorizontalAlignment of Right, which resolves to CurrentAndNext: a drag
         then resizes the splitter's own Auto column instead of the two panes - a gap that grows one
         way and a splitter that refuses to move the other. Measured, not guessed. -->
    <Style x:Key="Bt.GridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="{DynamicResource Bt.Size.SplitterThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ResizeDirection" Value="Columns"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Cursor" Value="SizeWE"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Hairline" Width="1" HorizontalAlignment="Center"
                                Background="{DynamicResource Bt.StrokeSubtleBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hairline" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Row splits need the hairline on the other axis; the bundle only shipped the column form. -->
    <Style x:Key="Bt.GridSplitter.Row" TargetType="GridSplitter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Height" Value="{DynamicResource Bt.Size.SplitterThickness}"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="ResizeDirection" Value="Rows"/>
        <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
        <Setter Property="Cursor" Value="SizeNS"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Hairline" Height="1" VerticalAlignment="Center"
                                Background="{DynamicResource Bt.StrokeSubtleBrush}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hairline" Property="Background" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ScrollBar: slim, terminal-appropriate ===== -->
    <Style x:Key="Bt.ScrollBar.Thumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Fill" CornerRadius="3" Margin="3,0,3,0"
                            Background="{DynamicResource Bt.StrokeDefaultBrush}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Bt.TextFillTertiaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Bt.ScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Bt.ScrollBar.Thumb}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
