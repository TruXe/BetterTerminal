<!-- Motion tokens (MO-01). Every Storyboard in the app references these keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <Duration x:Key="Motion.Duration.UltraFast">0:0:0.05</Duration>
    <Duration x:Key="Motion.Duration.Faster">0:0:0.1</Duration>
    <Duration x:Key="Motion.Duration.Fast">0:0:0.15</Duration>
    <Duration x:Key="Motion.Duration.Normal">0:0:0.2</Duration>
    <Duration x:Key="Motion.Duration.Gentle">0:0:0.25</Duration>
    <Duration x:Key="Motion.Duration.Slow">0:0:0.3</Duration>
    <Duration x:Key="Motion.Duration.Slower">0:0:0.4</Duration>
    <Duration x:Key="Motion.Duration.UltraSlow">0:0:0.5</Duration>

    <sys:TimeSpan x:Key="Motion.Time.Stagger1">0:0:0</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion.Time.Stagger2">0:0:0.05</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion.Time.Stagger3">0:0:0.1</sys:TimeSpan>
    <sys:TimeSpan x:Key="Motion.Time.Stagger4">0:0:0.15</sys:TimeSpan>

    <CubicEase x:Key="Motion.Ease.Enter" EasingMode="EaseOut"/>
    <CubicEase x:Key="Motion.Ease.Exit" EasingMode="EaseIn"/>
    <CubicEase x:Key="Motion.Ease.Standard" EasingMode="EaseInOut"/>

    <sys:Double x:Key="Motion.Travel.Item">8</sys:Double>
    <sys:Double x:Key="Motion.Travel.Surface">16</sys:Double>
    <sys:Double x:Key="Motion.Travel.Large">24</sys:Double>
</ResourceDictionary>
