<!-- Tier 1 of 3 (DS-02): raw values only. Views must never reference these keys. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Brand -->
    <Color x:Key="Bt.Color.Accent">#FFE4A130</Color>
    <Color x:Key="Bt.Color.AccentLight">#FFF0B24A</Color>
    <Color x:Key="Bt.Color.AccentDark">#FFC6871F</Color>
    <Color x:Key="Bt.Color.AccentDeep">#FF8A5504</Color>
    <Color x:Key="Bt.Color.AccentInk">#FF17181A</Color>

    <!-- Neutral ramp -->
    <Color x:Key="Bt.Color.Neutral.1000">#FF0A0B0C</Color>
    <Color x:Key="Bt.Color.Neutral.950">#FF0E0F11</Color>
    <Color x:Key="Bt.Color.Neutral.900">#FF15171A</Color>
    <Color x:Key="Bt.Color.Neutral.850">#FF1B1E22</Color>
    <Color x:Key="Bt.Color.Neutral.800">#FF23272C</Color>
    <Color x:Key="Bt.Color.Neutral.750">#FF31363C</Color>
    <Color x:Key="Bt.Color.Neutral.700">#FF22252A</Color>
    <Color x:Key="Bt.Color.Neutral.500">#FF6A7178</Color>
    <Color x:Key="Bt.Color.Neutral.400">#FF9AA1A9</Color>
    <Color x:Key="Bt.Color.Neutral.200">#FFCCD1D6</Color>
    <Color x:Key="Bt.Color.Neutral.150">#FFE2E5E8</Color>
    <Color x:Key="Bt.Color.Neutral.100">#FFECEEF0</Color>
    <Color x:Key="Bt.Color.Neutral.50">#FFFBFBFC</Color>
    <Color x:Key="Bt.Color.Neutral.25">#FFFCFCFB</Color>
    <Color x:Key="Bt.Color.Neutral.0">#FFFFFFFF</Color>
    <Color x:Key="Bt.Color.Ink">#FF191B1E</Color>
    <Color x:Key="Bt.Color.InkSecondary">#FF565D65</Color>
    <Color x:Key="Bt.Color.InkTertiary">#FF7F868E</Color>
    <Color x:Key="Bt.Color.Foam">#FFE6E8EA</Color>

    <!-- Status -->
    <Color x:Key="Bt.Color.Success.Dark">#FF5CB683</Color>
    <Color x:Key="Bt.Color.Success.Light">#FF1F7A4C</Color>
    <Color x:Key="Bt.Color.Warning.Dark">#FFDDA43C</Color>
    <Color x:Key="Bt.Color.Warning.Light">#FF8A5504</Color>
    <Color x:Key="Bt.Color.Error.Dark">#FFE5696A</Color>
    <Color x:Key="Bt.Color.Error.Light">#FFB02F2F</Color>
    <Color x:Key="Bt.Color.CloseRed">#FFC42B1C</Color>

    <!-- Overlay tints (state layers) -->
    <Color x:Key="Bt.Color.Overlay.LightHover">#0EFFFFFF</Color>
    <Color x:Key="Bt.Color.Overlay.LightPress">#06FFFFFF</Color>
    <Color x:Key="Bt.Color.Overlay.DarkHover">#0B000000</Color>
    <Color x:Key="Bt.Color.Overlay.DarkPress">#13000000</Color>
    <Color x:Key="Bt.Color.Overlay.AccentWashDark">#21E4A130</Color>
    <Color x:Key="Bt.Color.Overlay.AccentWashLight">#2EE4A130</Color>
    <Color x:Key="Bt.Color.Scrim">#57000000</Color>

    <!-- Code colours. Two sets, because the readable hue for a comment on a dark background is not
         the readable one on a light background; high contrast takes the system colours instead. -->
    <Color x:Key="Bt.Color.Code.Comment.Dark">#FF6A9955</Color>
    <Color x:Key="Bt.Color.Code.String.Dark">#FFCE9178</Color>
    <Color x:Key="Bt.Color.Code.Number.Dark">#FFB5CEA8</Color>
    <Color x:Key="Bt.Color.Code.Keyword.Dark">#FF569CD6</Color>
    <Color x:Key="Bt.Color.Code.Tag.Dark">#FF4EC9B0</Color>
    <Color x:Key="Bt.Color.Code.Attribute.Dark">#FF9CDCFE</Color>
    <Color x:Key="Bt.Color.Code.Property.Dark">#FFDCDCAA</Color>
    <Color x:Key="Bt.Color.Code.Operator.Dark">#FFC586C0</Color>

    <Color x:Key="Bt.Color.Code.Comment.Light">#FF107C10</Color>
    <Color x:Key="Bt.Color.Code.String.Light">#FFA31515</Color>
    <Color x:Key="Bt.Color.Code.Number.Light">#FF098658</Color>
    <Color x:Key="Bt.Color.Code.Keyword.Light">#FF0000C0</Color>
    <Color x:Key="Bt.Color.Code.Tag.Light">#FF0F6D68</Color>
    <Color x:Key="Bt.Color.Code.Attribute.Light">#FF1F5EA8</Color>
    <Color x:Key="Bt.Color.Code.Property.Light">#FF795E26</Color>
    <Color x:Key="Bt.Color.Code.Operator.Light">#FF8B2E8B</Color>

    <!-- Geometry / metric scalars (DIPs). -->
    <sys:Double x:Key="Bt.Size.TitleBarHeight">40</sys:Double>
    <sys:Double x:Key="Bt.Size.TabHeight">34</sys:Double>
    <sys:Double x:Key="Bt.Size.CommandBarHeight">38</sys:Double>
    <sys:Double x:Key="Bt.Size.PaneHeaderHeight">28</sys:Double>
    <sys:Double x:Key="Bt.Size.StatusBarHeight">26</sys:Double>
    <sys:Double x:Key="Bt.Size.ControlHeight">30</sys:Double>
    <sys:Double x:Key="Bt.Size.ControlHeightCompact">26</sys:Double>
    <sys:Double x:Key="Bt.Size.WindowButtonWidth">46</sys:Double>
    <sys:Double x:Key="Bt.Size.WindowButtonHeight">32</sys:Double>
    <sys:Double x:Key="Bt.Size.CaptionAccessoryWidth">32</sys:Double>
    <sys:Double x:Key="Bt.Size.IconSmall">14</sys:Double>
    <sys:Double x:Key="Bt.Size.IconMedium">16</sys:Double>
    <sys:Double x:Key="Bt.Size.SplitterThickness">6</sys:Double>

    <!-- How small a splitter may make a pane. The floor is what keeps a drag from collapsing a pane
         into a sliver that cannot be read or grabbed back: the header alone is 28, so anything much
         under this is a title bar with a hairline of terminal beneath it. Sized so a 1280-wide
         window still takes five columns side by side. -->
    <sys:Double x:Key="Bt.Size.PaneMinWidth">200</sys:Double>
    <sys:Double x:Key="Bt.Size.PaneMinHeight">130</sys:Double>

    <CornerRadius x:Key="Bt.Radius.Control">5</CornerRadius>
    <CornerRadius x:Key="Bt.Radius.Card">7</CornerRadius>
    <CornerRadius x:Key="Bt.Radius.Pane">6</CornerRadius>
    <CornerRadius x:Key="Bt.Radius.TabTop">6,6,0,0</CornerRadius>
    <CornerRadius x:Key="Bt.Radius.Badge">3</CornerRadius>

    <Thickness x:Key="Bt.Space.PaneGutter">8</Thickness>
    <Thickness x:Key="Bt.Space.ContentPad">26,22,30,22</Thickness>
    <Thickness x:Key="Bt.Space.ControlPad">10,0,10,0</Thickness>
    <Thickness x:Key="Bt.Space.ButtonPad">14,0,14,0</Thickness>
    <Thickness x:Key="Bt.Space.RowPad">12,0,12,0</Thickness>
</ResourceDictionary>
