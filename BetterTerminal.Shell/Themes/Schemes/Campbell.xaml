<!-- Terminal ANSI scheme. Separate from the app theme: the chrome theme and the
     scheme are independent user choices, so these keys are never used for chrome. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <sys:String x:Key="Bt.Scheme.Name">Campbell</sys:String>
    <Color x:Key="Bt.Scheme.Background">#FF0C0C0C</Color>
    <Color x:Key="Bt.Scheme.Foreground">#FFCCCCCC</Color>
    <Color x:Key="Bt.Scheme.Cursor">#FFCCCCCC</Color>
    <Color x:Key="Bt.Scheme.Selection">#FF3A3D41</Color>
    <Color x:Key="Bt.Scheme.Black">#FF0C0C0C</Color>
    <Color x:Key="Bt.Scheme.Red">#FFC50F1F</Color>
    <Color x:Key="Bt.Scheme.Green">#FF13A10E</Color>
    <Color x:Key="Bt.Scheme.Yellow">#FFC19C00</Color>
    <Color x:Key="Bt.Scheme.Blue">#FF0037DA</Color>
    <Color x:Key="Bt.Scheme.Magenta">#FF881798</Color>
    <Color x:Key="Bt.Scheme.Cyan">#FF3A96DD</Color>
    <Color x:Key="Bt.Scheme.White">#FFCCCCCC</Color>
    <Color x:Key="Bt.Scheme.BrightBlack">#FF767676</Color>
    <Color x:Key="Bt.Scheme.BrightRed">#FFE74856</Color>
    <Color x:Key="Bt.Scheme.BrightGreen">#FF16C60C</Color>
    <Color x:Key="Bt.Scheme.BrightYellow">#FFF9F1A5</Color>
    <Color x:Key="Bt.Scheme.BrightBlue">#FF3B78FF</Color>
    <Color x:Key="Bt.Scheme.BrightMagenta">#FFB4009E</Color>
    <Color x:Key="Bt.Scheme.BrightCyan">#FF61D6D6</Color>
    <Color x:Key="Bt.Scheme.BrightWhite">#FFF2F2F2</Color>
</ResourceDictionary>
