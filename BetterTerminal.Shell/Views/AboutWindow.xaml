<Window x:Class="BetterTerminal.Shell.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:BetterTerminal.Shell.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:AboutViewModel, IsDesignTimeCreatable=True}"
        Title="About BetterTerminal"
        Width="460" SizeToContent="Height" MinHeight="300"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
        Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
        FontFamily="{DynamicResource Bt.Font.Ui}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="0"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36" Background="{DynamicResource Bt.ChromeBackgroundBrush}">
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Bt.Text.BodyStrong}"
                       Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"
                       Text="About BetterTerminal"/>
            <Button HorizontalAlignment="Right" Width="40" Height="36"
                    Style="{StaticResource Bt.Button.CaptionClose}"
                    Click="OnClose" AutomationProperties.Name="Close">
                <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE8BB;"/>
            </Button>
        </Grid>

        <StackPanel Grid.Row="1" Margin="24,26,24,26">
            <StackPanel Orientation="Horizontal">
                <Control Style="{StaticResource Bt.BrandMark}" Width="52" Height="52"/>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Bt.Text.Subtitle}" FontSize="18"
                               FontFamily="{DynamicResource Bt.Font.Display}" Text="BetterTerminal"/>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Bt.Text.MonoSmall}"
                               Text="{Binding VersionLine}"/>
                </StackPanel>
            </StackPanel>

            <!-- Factual rows only: no press-release copy (SLOP-59), no invented stats (SLOP-63). -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Bt.Text.Caption}" Text="Runtime"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="16,0,0,0"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
                           Text="{Binding Runtime}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0"
                           Style="{StaticResource Bt.Text.Caption}" Text="Backend"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="16,8,0,0"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
                           Text="{Binding Backend}"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,0,0"
                           Style="{StaticResource Bt.Text.Caption}" Text="Host"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="16,8,0,0"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
                           Text="{Binding HostOs}"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,8,0,0"
                           Style="{StaticResource Bt.Text.Caption}" Text="Workspace"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="16,8,0,0"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
                           TextWrapping="Wrap" TextTrimming="None"
                           Text="{Binding SettingsPath}"/>
            </Grid>

            <Rectangle Height="1" Margin="0,20,0,0" Fill="{DynamicResource Bt.StrokeSubtleBrush}"/>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource Bt.Button.Chrome}" Padding="0" Margin="0,0,16,0"
                            Command="{Binding OpenReleaseNotesCommand}"
                            Foreground="{DynamicResource Bt.AccentTextBrush}" Content="Documentation"/>
                    <Button Style="{StaticResource Bt.Button.Chrome}" Padding="0"
                            Command="{Binding OpenNoticesCommand}"
                            Foreground="{DynamicResource Bt.AccentTextBrush}" Content="Open workspace folder"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Bt.Button.Secondary}"
                        Height="28" Command="{Binding CopyDetailsCommand}"
                        Content="Copy details"
                        AutomationProperties.Name="Copy these details to the clipboard"/>
            </Grid>
        </StackPanel>
    </Grid>
</Window>
