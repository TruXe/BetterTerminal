<UserControl x:Class="BetterTerminal.Shell.Views.CommandPalette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:BetterTerminal.Shell.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CommandPaletteViewModel, IsDesignTimeCreatable=True}"
             FontFamily="{DynamicResource Bt.Font.Ui}">

    <!-- Overlay host. The scrim is a token brush, not a BlurEffect stack (SLOP-22). -->
    <Grid>
        <Rectangle Fill="{DynamicResource Bt.ScrimBrush}" MouseLeftButtonDown="OnScrimClick"/>

        <Border x:Name="Surface" Width="640" MaxHeight="440"
                VerticalAlignment="Top" Margin="0,36,0,0"
                Background="{DynamicResource Bt.ElevatedBackgroundBrush}"
                BorderBrush="{DynamicResource Bt.StrokeDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource Bt.Radius.Card}"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SurfaceShift" Y="0"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <!-- Enter: decelerate at Normal, travel capped at Motion.Travel.Surface (MO-05, MO-11).
                     Content is readable at frame 0 - only opacity and offset move (MO-09). -->
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1"
                                             Duration="{StaticResource Motion.Duration.Normal}"
                                             EasingFunction="{StaticResource Motion.Ease.Enter}"/>
                            <DoubleAnimation Storyboard.TargetName="SurfaceShift"
                                             Storyboard.TargetProperty="Y"
                                             From="-16" To="0"
                                             Duration="{StaticResource Motion.Duration.Normal}"
                                             EasingFunction="{StaticResource Motion.Ease.Enter}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Height="46" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}">
                    <Grid Margin="14,0,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource Bt.Text.Icon}"
                                   FontSize="15" VerticalAlignment="Center" Text="&#xE721;"
                                   Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"/>
                        <Label Grid.Column="1" Visibility="Collapsed"
                               Target="{Binding ElementName=Query}" Content="_Search commands"/>
                        <TextBox Grid.Column="1" x:Name="Query" Margin="10,0,10,0"
                                 Style="{StaticResource Bt.TextBox}"
                                 Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="{DynamicResource Bt.FontSize.Subtitle}"
                                 BorderThickness="0" Background="Transparent"
                                 PreviewKeyDown="OnQueryKeyDown"
                                 AutomationProperties.Name="Search commands"/>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                   Style="{StaticResource Bt.Text.Caption}"
                                   Text="{Binding ResultSummary}"/>
                    </Grid>
                </Border>

                <ListBox Grid.Row="1" x:Name="ResultList" Margin="6"
                         Style="{StaticResource Bt.ListBox.Plain}"
                         ItemContainerStyle="{StaticResource Bt.RowItem}"
                         ItemsSource="{Binding Results}"
                         SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                         MouseDoubleClick="OnResultActivated"
                         AutomationProperties.Name="Matching commands">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CommandItemViewModel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource Bt.Text.Icon}"
                                           VerticalAlignment="Center" Text="{Binding Glyph}"
                                           Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                           Style="{StaticResource Bt.Text.BodyStrong}"
                                           Text="{Binding Name}" ToolTip="{Binding Name}"/>
                                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                           Style="{StaticResource Bt.Text.Caption}"
                                           Text="{Binding Group}"/>
                                <Border Grid.Column="3" Margin="12,0,0,0" MinWidth="78"
                                        Style="{StaticResource Bt.Badge.Outline}">
                                    <TextBlock HorizontalAlignment="Center"
                                               Style="{StaticResource Bt.Text.MonoSmall}"
                                               Text="{Binding KeysDisplay}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Height="32" BorderThickness="0,1,0,0"
                        BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}"
                        Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
                        CornerRadius="0,0,6,6">
                    <Grid Margin="14,0,14,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Bt.Text.Caption}" Text="Up and down arrows navigate"/>
                            <TextBlock Style="{StaticResource Bt.Text.Caption}" Margin="16,0,0,0" Text="Enter runs"/>
                            <TextBlock Style="{StaticResource Bt.Text.Caption}" Margin="16,0,0,0" Text="Esc dismisses"/>
                        </StackPanel>
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Style="{StaticResource Bt.Text.Caption}"
                                   Text="Type &gt; to send input to the shell instead"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
