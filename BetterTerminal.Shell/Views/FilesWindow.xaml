<Window x:Class="BetterTerminal.Shell.Views.FilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:BetterTerminal.Shell.ViewModels"
        xmlns:views="clr-namespace:BetterTerminal.Shell.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:FileExplorerViewModel, IsDesignTimeCreatable=True}"
        Title="Files"
        Width="1020" Height="680" MinWidth="720" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
        Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
        FontFamily="{DynamicResource Bt.Font.Ui}"
        FontSize="{DynamicResource Bt.FontSize.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Without a name the row announces its view-model type, as the saved-connections list
             found out; the header is a panel, so the name has to be set on the container. -->
        <Style x:Key="Bt.FileRow" TargetType="TreeViewItem" BasedOn="{StaticResource Bt.TreeViewItem}">
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}"/>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 caption -->
            <RowDefinition Height="*"/>      <!-- 1 tree and editor -->
            <RowDefinition Height="Auto"/>   <!-- 2 status strip -->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36" Background="{DynamicResource Bt.ChromeBackgroundBrush}">
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Bt.Text.BodyStrong}"
                       Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"
                       Text="Files"/>
            <Button HorizontalAlignment="Right" Width="40" Height="36"
                    Style="{StaticResource Bt.Button.CaptionClose}"
                    Click="OnClose" AutomationProperties.Name="Close">
                <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE8BB;"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="14,12,14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="180"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="260"/>
            </Grid.ColumnDefinitions>

            <!-- ===== the folder ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource Bt.Text.Overline}" Text="Folder"/>

                <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Bt.Card}">
                    <TreeView Margin="6" Background="Transparent" BorderThickness="0"
                              ItemsSource="{Binding Roots}"
                              ItemContainerStyle="{StaticResource Bt.FileRow}"
                              SelectedItemChanged="OnSelectedItemChanged"
                              AutomationProperties.Name="Files in this folder">
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="12"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource Bt.TextFillTertiaryBrush}"
                                               Text="{Binding Glyph}"/>
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center"
                                               Style="{StaticResource Bt.Text.Body}"
                                               Text="{Binding Name}"
                                               ToolTip="{Binding FullPath}"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Style="{StaticResource Bt.GridSplitter}"
                          VerticalAlignment="Stretch"
                          AutomationProperties.Name="Resize the folder list"/>

            <!-- ===== the open files ===== -->
            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="0"
                        ItemsSource="{Binding Documents}"
                        SelectedItem="{Binding SelectedDocument, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource Bt.TabItem}"
                        AutomationProperties.Name="Open files">
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:FileDocumentViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Style="{StaticResource Bt.Text.Body}"
                                       Text="{Binding Name}"
                                       ToolTip="{Binding FullPath}"/>
                            <!-- Unsaved is a dot AND the tooltip text, never colour alone. -->
                            <Ellipse Grid.Column="1" Width="6" Height="6" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Bt.AccentFillDefaultBrush}"
                                     ToolTip="Not saved yet"
                                     Visibility="{Binding IsDirty, Converter={StaticResource Bt.BoolToVisibility}}"/>
                            <Button Grid.Column="2" Margin="6,0,0,0" Width="20" Height="20"
                                    Style="{StaticResource Bt.Button.Icon}"
                                    Command="{Binding CloseCommand}"
                                    AutomationProperties.Name="Close this file">
                                <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate DataType="{x:Type vm:FileDocumentViewModel}">
                        <!-- One of the three is visible: what the file turned out to be decides,
                             not its name. A picture and a dump are shown, never edited. -->
                        <Grid>
                            <views:CodeEditor Style="{StaticResource Bt.CodeEditor}"
                                              SourceText="{Binding Text, Mode=TwoWay}"
                                              Syntax="{Binding Language}"
                                              IsReadOnly="{Binding IsReadOnly}"
                                              Visibility="{Binding IsCode, Converter={StaticResource Bt.BoolToVisibility}}"
                                              AutomationProperties.Name="{Binding Name}"/>

                            <TextBox Style="{StaticResource Bt.TextBox.Editor}"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     Visibility="{Binding IsPlainText, Converter={StaticResource Bt.BoolToVisibility}}"
                                     AutomationProperties.Name="{Binding Name}"/>

                            <Border Background="{DynamicResource Bt.TerminalBackgroundBrush}"
                                    BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}"
                                    BorderThickness="1"
                                    Visibility="{Binding IsImage, Converter={StaticResource Bt.BoolToVisibility}}">
                                <!-- Shown at its own size, and only shrunk when it does not fit. -->
                                <Image Source="{Binding Image}" Margin="10"
                                       Stretch="Uniform" StretchDirection="DownOnly"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       AutomationProperties.Name="{Binding Name}"/>
                            </Border>

                            <TextBox Style="{StaticResource Bt.TextBox.Editor}"
                                     Text="{Binding Preview, Mode=OneWay}" IsReadOnly="True"
                                     Visibility="{Binding IsBinary, Converter={StaticResource Bt.BoolToVisibility}}"
                                     AutomationProperties.Name="{Binding Name}"/>
                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <Border Grid.Row="2" Height="{DynamicResource Bt.Size.StatusBarHeight}"
                Background="{DynamicResource Bt.ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Text="{Binding Message}" ToolTip="{Binding Message}"/>
                <!-- What is on screen - the encoding, the size, the dimensions - gets its own
                     place, because a long path would otherwise trim it away. -->
                <TextBlock Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Bt.Text.Caption}"
                           Foreground="{DynamicResource Bt.AccentTextBrush}"
                           Text="{Binding SelectedDocument.Details}"/>
                <TextBlock Grid.Column="2" Margin="14,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Bt.Text.Caption}"
                           Text="Ctrl+S saves the open file"/>
            </Grid>
        </Border>
    </Grid>
</Window>
