<Window x:Class="BetterTerminal.Shell.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:BetterTerminal.Shell.ViewModels"
        xmlns:views="clr-namespace:BetterTerminal.Shell.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=True}"
        Title="BetterTerminal"
        Width="1280" Height="820" MinWidth="640" MinHeight="420"
        Background="{DynamicResource Bt.ChromeBackgroundBrush}"
        Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
        FontFamily="{DynamicResource Bt.Font.Ui}"
        FontSize="{DynamicResource Bt.FontSize.Body}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Custom chrome: tabs live in the caption strip. CaptionHeight leaves the drag band,
         every interactive child sets IsHitTestVisibleInChrome. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control+Shift" Key="T" Command="{Binding NewTabCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="W" Command="{Binding ClosePaneCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="P" Command="{Binding OpenPaletteCommand}"/>
        <KeyBinding Modifiers="Alt+Shift" Key="OemPlus" Command="{Binding SplitRightCommand}"/>
        <KeyBinding Modifiers="Alt+Shift" Key="OemMinus" Command="{Binding SplitDownCommand}"/>
        <KeyBinding Modifiers="Control" Key="OemComma" Command="{Binding OpenSettingsCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Right" Command="{Binding FocusNextPaneCommand}"/>
        <KeyBinding Modifiers="Alt" Key="Left" Command="{Binding FocusPreviousPaneCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0 caption + tabs -->
            <RowDefinition Height="Auto"/>   <!-- 1 command bar -->
            <RowDefinition Height="*"/>      <!-- 2 pane grid -->
            <RowDefinition Height="Auto"/>   <!-- 3 status strip -->
        </Grid.RowDefinitions>

        <!-- ============ row 0: caption strip ============ -->
        <Grid Grid.Row="0" Height="{DynamicResource Bt.Size.TitleBarHeight}"
              Background="{DynamicResource Bt.ChromeBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Control Grid.Column="0" Style="{StaticResource Bt.BrandMark}" Width="17" Height="17"
                     Margin="10,0,12,0" VerticalAlignment="Center"
                     AutomationProperties.Name="BetterTerminal"/>

            <!-- Tab strip. The TabControl's content host is row 2, so only headers render here. -->
            <TabControl Grid.Column="1" x:Name="TabStrip"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        Background="Transparent" BorderThickness="0" Padding="0"
                        ItemContainerStyle="{StaticResource Bt.TabItem}"
                        VerticalAlignment="Bottom"
                        AutomationProperties.Name="Open sessions">
                <TabControl.Resources>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </Style>
                </TabControl.Resources>
                <TabControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TabViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Control Grid.Column="0" Style="{StaticResource Bt.BrandMark}"
                                     Width="13" Height="13" VerticalAlignment="Center"
                                     Foreground="{Binding IconBrush}"/>
                            <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Title}"
                                       ToolTip="{Binding FullTitle}"
                                       Style="{StaticResource Bt.Text.Body}"/>
                            <!-- Failure is a dot AND the tooltip text, never colour alone (BP-R27). -->
                            <Ellipse Grid.Column="2" Width="6" Height="6" Margin="8,0,0,0"
                                     VerticalAlignment="Center"
                                     Fill="{DynamicResource Bt.StatusErrorBrush}"
                                     ToolTip="{Binding LastExitDescription}"
                                     Visibility="{Binding HasFailed, Converter={StaticResource Bt.BoolToVisibility}}"/>
                            <Button Grid.Column="3" Margin="6,0,0,0" Width="20" Height="20"
                                    Style="{StaticResource Bt.Button.Icon}"
                                    Command="{Binding CloseCommand}"
                                    AutomationProperties.Name="Close this session">
                                <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </TabControl.ItemTemplate>
            </TabControl>

            <!-- The tab actions sit in the caption strip with the window buttons, one band, one
                 glyph size; the gap after them is what keeps the plus off the minimise target. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Bt.Button.CaptionAccessory}"
                        Command="{Binding NewTabCommand}"
                        AutomationProperties.Name="New tab"
                        ToolTip="New tab (Ctrl+Shift+T)">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE710;"/>
                </Button>
                <Button Style="{StaticResource Bt.Button.CaptionAccessory}" Margin="0,0,8,0"
                        Command="{Binding OpenProfileFlyoutCommand}"
                        AutomationProperties.Name="Open a session with a specific profile">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE70D;"/>
                </Button>
                <Button Style="{StaticResource Bt.Button.Caption}" Click="OnMinimize"
                        AutomationProperties.Name="Minimize">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE921;"/>
                </Button>
                <Button Style="{StaticResource Bt.Button.Caption}" Click="OnToggleMaximize"
                        AutomationProperties.Name="Maximize or restore">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE922;"/>
                </Button>
                <Button Style="{StaticResource Bt.Button.CaptionClose}" Click="OnClose"
                        AutomationProperties.Name="Close window">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE8BB;"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ row 1: command bar ============ -->
        <Border Grid.Row="1" Height="{DynamicResource Bt.Size.CommandBarHeight}"
                Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
                BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Target="{Binding ElementName=ProfilePicker}"
                       Visibility="Collapsed" Content="_Profile"/>
                <ComboBox Grid.Column="0" x:Name="ProfilePicker"
                          Style="{StaticResource Bt.ComboBox}"
                          ItemsSource="{Binding Profiles}"
                          SelectedItem="{Binding DefaultProfile, Mode=TwoWay}"
                          AutomationProperties.Name="Profile for new sessions">
                    <!-- An explicit template, not DisplayMemberPath: the templated selection box
                         renders SelectionBoxItem directly and would otherwise show ToString(). -->
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ProfileViewModel}">
                            <TextBlock Style="{StaticResource Bt.Text.Body}" Text="{Binding Name}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Rectangle Grid.Column="1" Width="1" Height="18" Margin="8,0,8,0"
                           Fill="{DynamicResource Bt.StrokeDefaultBrush}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource Bt.Button.Chrome}" Command="{Binding NewTabCommand}"
                            AutomationProperties.Name="New tab" ToolTip="Ctrl+Shift+T">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE710;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="New tab"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Bt.Button.Chrome}" Command="{Binding SplitRightCommand}"
                            AutomationProperties.Name="Split pane right" ToolTip="Alt+Shift+Plus">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xEE3F;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Split right"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Bt.Button.Chrome}" Command="{Binding SplitDownCommand}"
                            AutomationProperties.Name="Split pane down" ToolTip="Alt+Shift+Minus">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xEE40;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Split down"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Bt.Button.Chrome}" Command="{Binding ClosePaneCommand}"
                            AutomationProperties.Name="Close the focused pane" ToolTip="Ctrl+Shift+W">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE89F;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Close pane"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Saved connections and the project settings: the two surfaces that are not
                     about the pane in front of you. The primary fill marks the first one as the
                     bar's main action. -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="14,0,0,0"
                            HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource Bt.Button.Accent}" Height="28"
                            Command="{Binding OpenConnectionsCommand}"
                            AutomationProperties.Name="Saved connections"
                            ToolTip="Saved connections">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="12"
                                       Foreground="{DynamicResource Bt.AccentInkBrush}" Text="&#xE8AF;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Bt.AccentInkBrush}" Text="SSH"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Style="{StaticResource Bt.Button.Chrome}"
                            Command="{Binding OpenFilesCommand}"
                            AutomationProperties.Name="Files in this folder"
                            ToolTip="Files in this folder">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE8DA;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Files"/>
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Style="{StaticResource Bt.Button.Chrome}"
                            Command="{Binding OpenWorkspaceSetupCommand}"
                            AutomationProperties.Name="Workspace setup"
                            ToolTip="Workspace setup">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE8B7;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Workspace"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button Grid.Column="4" Style="{StaticResource Bt.Button.Chrome}"
                        Command="{Binding OpenPaletteCommand}"
                        AutomationProperties.Name="Open the command palette">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE721;"/>
                        <TextBlock Margin="7,0,8,0" VerticalAlignment="Center" Text="Commands"/>
                        <Border Style="{StaticResource Bt.Badge.Outline}">
                            <TextBlock Style="{StaticResource Bt.Text.MonoSmall}" Text="Ctrl+Shift+P"/>
                        </Border>
                    </StackPanel>
                </Button>

                <Button Grid.Column="5" Style="{StaticResource Bt.Button.Icon}" Margin="4,0,0,0"
                        Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.Name="Settings" ToolTip="Settings (Ctrl+comma)">
                    <TextBlock Style="{StaticResource Bt.Text.Icon}" Text="&#xE713;"/>
                </Button>
            </Grid>
        </Border>

        <!-- ============ row 2: pane tree for the selected tab ============ -->
        <Border Grid.Row="2" Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
                Padding="{DynamicResource Bt.Space.PaneGutter}">
            <ContentControl Content="{Binding SelectedTab.RootPane}"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <ContentControl.Resources>
                    <!-- A pane tree is recursive: leaf renders a session, branch renders a splitter. -->
                    <DataTemplate DataType="{x:Type vm:PaneViewModel}">
                        <Border BorderThickness="1"
                                CornerRadius="{DynamicResource Bt.Radius.Pane}"
                                Background="{DynamicResource Bt.TerminalBackgroundBrush}"
                                SnapsToDevicePixels="True">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Bt.StrokeSubtleBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Bt.AccentFillDefaultBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Height="{DynamicResource Bt.Size.PaneHeaderHeight}"
                                        Background="{DynamicResource Bt.ElevatedBackgroundBrush}"
                                        BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="5,5,0,0">
                                    <Grid Margin="10,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="5" Height="5" VerticalAlignment="Center"
                                                 Fill="{Binding FocusDotBrush}"/>
                                        <!-- Long paths ellipsize, never clip silently (BP-R4). -->
                                        <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center"
                                                   Style="{StaticResource Bt.Text.MonoSmall}"
                                                   Text="{Binding WorkingDirectory}"
                                                   ToolTip="{Binding WorkingDirectory}"/>
                                        <Border Grid.Column="2" Style="{StaticResource Bt.Badge}"
                                                Visibility="{Binding HasBadge, Converter={StaticResource Bt.BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Bt.Text.Caption}"
                                                       Foreground="{Binding BadgeBrush}"
                                                       Text="{Binding BadgeText}"/>
                                        </Border>
                                        <Button Grid.Column="3" Margin="6,0,0,0" Width="20" Height="20"
                                                Style="{StaticResource Bt.Button.Icon}"
                                                Command="{Binding CloseCommand}"
                                                AutomationProperties.Name="Close this pane">
                                            <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE711;"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- The live terminal is the pane's Surface; the design-time TextBlock
                                     is what the designer surface shows when there is no session. -->
                                <Grid Grid.Row="1" x:Name="TerminalHost" Margin="12,10,12,10">
                                    <TextBlock Style="{StaticResource Bt.Text.Mono}"
                                               TextTrimming="None"
                                               Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
                                               Text="{Binding DesignTimePreview}"/>
                                    <ContentPresenter Content="{Binding Surface}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:ColumnSplitViewModel}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding FirstLength, Mode=TwoWay}" MinWidth="120"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="{Binding SecondLength, Mode=TwoWay}" MinWidth="120"/>
                            </Grid.ColumnDefinitions>
                            <ContentControl Grid.Column="0" Content="{Binding First}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            <GridSplitter Grid.Column="1" Style="{StaticResource Bt.GridSplitter}"
                                          VerticalAlignment="Stretch"
                                          AutomationProperties.Name="Resize these panes"/>
                            <ContentControl Grid.Column="2" Content="{Binding Second}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        </Grid>
                    </DataTemplate>

                    <DataTemplate DataType="{x:Type vm:RowSplitViewModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="{Binding FirstLength, Mode=TwoWay}" MinHeight="90"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="{Binding SecondLength, Mode=TwoWay}" MinHeight="90"/>
                            </Grid.RowDefinitions>
                            <ContentControl Grid.Row="0" Content="{Binding First}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                            <GridSplitter Grid.Row="1" Style="{StaticResource Bt.GridSplitter.Row}"
                                          HorizontalAlignment="Stretch"
                                          AutomationProperties.Name="Resize these panes"/>
                            <ContentControl Grid.Row="2" Content="{Binding Second}"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
                        </Grid>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </Border>

        <!-- ============ row 3: status strip - shell, path, exit code, nothing else ============ -->
        <Border Grid.Row="3" Height="{DynamicResource Bt.Size.StatusBarHeight}"
                Background="{DynamicResource Bt.ChromeBackgroundBrush}"
                BorderBrush="{DynamicResource Bt.StrokeSubtleBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                           Style="{StaticResource Bt.Text.BodySecondary}"
                           Text="{Binding ActivePane.ShellDescription}"/>
                <Rectangle Grid.Column="1" Width="1" Height="12" Margin="14,0,14,0"
                           Fill="{DynamicResource Bt.StrokeDefaultBrush}"/>
                <TextBlock Grid.Column="2" VerticalAlignment="Center"
                           Style="{StaticResource Bt.Text.MonoSmall}"
                           Text="{Binding ActivePane.WorkingDirectory}"
                           ToolTip="{Binding ActivePane.WorkingDirectory}"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Bt.Badge}" Margin="0,0,14,0"
                            Visibility="{Binding HasProject, Converter={StaticResource Bt.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Bt.Text.Caption}"
                                   Foreground="{DynamicResource Bt.AccentTextBrush}"
                                   Text="{Binding ProjectName}"
                                   ToolTip="The project this window was opened in"/>
                    </Border>
                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                             Fill="{Binding ActivePane.ExitBrush}"/>
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center"
                               Style="{StaticResource Bt.Text.Caption}"
                               Foreground="{Binding ActivePane.ExitBrush}"
                               Text="{Binding ActivePane.ExitDescription}"/>
                </StackPanel>
            </Grid>
        </Border>

        <views:CommandPalette x:Name="Palette" Grid.Row="0" Grid.RowSpan="4"/>
    </Grid>
</Window>
