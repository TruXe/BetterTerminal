<Window x:Class="BetterTerminal.Shell.Views.ConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:BetterTerminal.Shell.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:ConnectionsViewModel, IsDesignTimeCreatable=True}"
        Title="Saved connections"
        Width="760" Height="480" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bt.SurfaceBackgroundBrush}"
        Foreground="{DynamicResource Bt.TextFillPrimaryBrush}"
        FontFamily="{DynamicResource Bt.Font.Ui}"
        FontSize="{DynamicResource Bt.FontSize.Body}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- The one status carrier: a filled heart for a host that answered, an outline for one
             that did not. Shape and colour move together, and the tooltip says it in words. -->
        <Style x:Key="Bt.ReachabilityHeart" TargetType="TextBlock" BasedOn="{StaticResource Bt.Text.Icon}">
            <Setter Property="Text" Value="&#xEB51;"/>
            <Setter Property="Foreground" Value="{DynamicResource Bt.TextFillTertiaryBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ConnectionStatus.Reachable}">
                    <Setter Property="Text" Value="&#xEB52;"/>
                    <Setter Property="Foreground" Value="{DynamicResource Bt.StatusSuccessBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="{x:Static vm:ConnectionStatus.Unreachable}">
                    <Setter Property="Foreground" Value="{DynamicResource Bt.StatusErrorBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36" Background="{DynamicResource Bt.ChromeBackgroundBrush}">
            <TextBlock Margin="14,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Bt.Text.BodyStrong}"
                       Foreground="{DynamicResource Bt.TextFillSecondaryBrush}"
                       Text="Saved connections"/>
            <Button HorizontalAlignment="Right" Width="40" Height="36"
                    Style="{StaticResource Bt.Button.CaptionClose}"
                    Click="OnClose" AutomationProperties.Name="Close">
                <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="10" Text="&#xE8BB;"/>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="20,18,20,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- ===== the list ===== -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Bt.Text.Overline}"
                               Text="Connections"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource Bt.Button.Chrome}"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="Check every connection again">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="12" Text="&#xE72C;"/>
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Check again"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Margin="0,10,0,0" Style="{StaticResource Bt.Card}">
                    <ListBox Style="{StaticResource Bt.ListBox.Plain}" Margin="6"
                             ItemsSource="{Binding Connections}"
                             SelectedItem="{Binding Selected, Mode=TwoWay}"
                             AutomationProperties.Name="Saved connections">
                        <ListBox.ItemContainerStyle>
                            <!-- Without a name the row announces its view-model type. -->
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource Bt.RowItem}">
                                <Setter Property="AutomationProperties.Name" Value="{Binding Display}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConnectionViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Style="{StaticResource Bt.ReachabilityHeart}"
                                               ToolTip="{Binding StatusDescription}"/>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Bt.Text.Body}" Text="{Binding Display}"/>
                                        <TextBlock Style="{StaticResource Bt.Text.Caption}"
                                                   Text="{Binding StatusDescription}"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Width="28" Height="28"
                                            Style="{StaticResource Bt.Button.Icon}"
                                            Command="{Binding RemoveCommand}"
                                            AutomationProperties.Name="Remove this connection">
                                        <TextBlock Style="{StaticResource Bt.Text.Icon}" FontSize="12" Text="&#xE74D;"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <Rectangle Grid.Column="1" Width="1" Margin="18,0,18,0"
                       Fill="{DynamicResource Bt.StrokeSubtleBrush}"/>

            <!-- ===== add and connect ===== -->
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Bt.Text.Overline}" Text="Add a connection"/>

                <TextBlock Margin="0,10,0,6" Style="{StaticResource Bt.Text.Caption}" Text="User name"/>
                <TextBox Style="{StaticResource Bt.TextBox}"
                         Text="{Binding NewUserName, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="User name"/>

                <TextBlock Margin="0,12,0,6" Style="{StaticResource Bt.Text.Caption}" Text="Address"/>
                <TextBox Style="{StaticResource Bt.TextBox}"
                         Text="{Binding NewHost, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="Address"/>

                <Button Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="92"
                        Style="{StaticResource Bt.Button.Secondary}"
                        Command="{Binding SaveCommand}" Content="Save"
                        AutomationProperties.Name="Save this connection"/>

                <Rectangle Height="1" Margin="0,20,0,20" Fill="{DynamicResource Bt.StrokeSubtleBrush}"/>

                <TextBlock Style="{StaticResource Bt.Text.Overline}" Text="Open the connection"/>
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Bt.Segment}" GroupName="Target"
                                 IsChecked="{Binding OpensInGrid, Mode=TwoWay}"
                                 Content="In the pane grid"/>
                    <RadioButton Style="{StaticResource Bt.Segment}" GroupName="Target"
                                 IsChecked="{Binding OpensInSeparateWindow, Mode=TwoWay}"
                                 Content="In a separate window"/>
                </StackPanel>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Bt.Text.MonoSmall}"
                           TextWrapping="Wrap" TextTrimming="None"
                           Text="{Binding Selected.CommandLine}"/>

                <Button Margin="0,14,0,0" HorizontalAlignment="Left" MinWidth="120"
                        Style="{StaticResource Bt.Button.Accent}"
                        Command="{Binding ConnectCommand}" Content="Connect"
                        AutomationProperties.Name="Connect to the selected host"/>

                <TextBlock Margin="0,14,0,0" Style="{StaticResource Bt.Text.Caption}"
                           TextWrapping="Wrap" TextTrimming="None" Text="{Binding Message}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
